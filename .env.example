# ── MongoDB ────────────────────────────────────────────────────────────
# Single-node replica set URI (used inside Docker: service name = mongodb)
MONGO_URI=mongodb://mongodb:27017/?replicaSet=rs0
MONGO_DB_NAME=ecommerce

# ── Application ────────────────────────────────────────────────────────
APP_NAME=E-Commerce Order System
DEBUG=false

# ── Frontend (used at build time by Vite) ─────────────────────────────
# The URL the browser uses to reach the backend API.
# In Docker: requests go via nginx proxy, so use relative path or http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000
